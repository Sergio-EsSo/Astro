---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";

const res = await fetch("https://api.coinpaprika.com/v1/tickers/btc-bitcoin")
if(!res.ok){
    throw new Error("Fallo al conectarse a la api: "+res.status)
}
const datos = await res.json()
const precioBitcoin = datos.quotes.USD.price
const precioBitcoinFormateado = precioBitcoin.toFixed(2)
---

<BaseLayout>
    <h1>Precio de bitcoin</h1>
    <p>1 BTC = {precioBitcoinFormateado} USD</p>
</BaseLayout>