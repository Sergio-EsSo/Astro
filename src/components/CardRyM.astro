---
const {char} = Astro.props;
---
<div class="card">
    <div>
        <img src={char.image} alt={char.name} class="card-img">
    </div>
    <p class="name">
        {char.name}
    </p>
</div>

<style>
    .card{
        width: 200px;
        max-width: 100%;
        background-color: rgb(236, 228, 228);
        border: 2px solid rgb(148, 148, 148);
        padding: 20px;
        font-family: Arial, Helvetica, sans-serif;
        box-sizing: border-box;
    }
    .card-img{
        width: 100%;
        height: 100%;
        object-fit: cover;
        flex-shrink: 0;
    }
    .name{
        margin: 10px 0 4px 0;
        color: black;
        font-size: 1.2rem;
        text-align: center;
    }
</style>